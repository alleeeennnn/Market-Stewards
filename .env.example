# Market Stewards — local environment
#
# Copy this file to `.env` and paste your free Finnhub key.
# Get one at https://finnhub.io (free, no card).
#
# Without a key the site still runs: every price is generated
# locally and the UI shows a DEMO DATA badge instead of LIVE.
#
# Note: VITE_ variables are inlined into the client bundle, so this
# key is public. Never use a paid Finnhub plan key here.

VITE_FINNHUB_TOKEN=
